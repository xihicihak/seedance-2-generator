generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  credits       Int        @default(30)
  role          String     @default("USER")
  createdAt     DateTime   @default(now())
  customApiKey  String?    @db.Text
  accounts      Account[]
  creations     Creation[]
  sessions      Session[]
  purchases     CreationPurchase[]
}

model Creation {
  id          String   @id @default(cuid())
  prompt      String
  imageUrl    String?
  aspectRatio String?
  resolution  String?
  createdAt   DateTime @default(now())
  userId      String?
  error       String?
  requestId   String?  @unique
  status      String   @default("processing")
  duration    Int?
  quality     String?
  audioFiles  String[]
  videoFiles  String[]
  inputImages String?  @db.Text
  isPublished Boolean  @default(false)
  price       Int      @default(10)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases   CreationPurchase[]
}

model CreationPurchase {
  id             String   @id @default(cuid())
  userId         String
  creationId     String
  creatorId      String
  amountPaid     Int
  creatorAmount  Int
  maintenanceFee Int
  platformFee    Int
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creation       Creation @relation(fields: [creationId], references: [id], onDelete: Cascade)

  @@unique([userId, creationId])
  @@index([userId])
  @@index([creationId])
  @@index([creatorId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
