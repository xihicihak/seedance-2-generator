# Supabase Database (PostgreSQL)
# Connection Pooling (Session mode or Transaction mode)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for migrations and Prisma db push
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# NextAuth Configuration
NEXTAUTH_URL="https://www.pornmakes.com"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Google OAuth (for user authentication)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Wan 2.2 GPU Compute Node (ComfyUI)
COMFYUI_API_URL="http://127.0.0.1:8188"

# Stripe Payments (for Credit Packs)
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Site Domain
NEXT_PUBLIC_APP_URL="https://www.pornmakes.com"
